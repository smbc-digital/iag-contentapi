{
  "UseAWSSecretManager": true,
  "AWSSecretsManagerConfiguration:EnvironmentGroupPrefix": "iag-preprod",
  "Contentful:UsePreviewAPI": false,
  "UseRedisSessions": "true",
  "redisExpiryTimes": {
    "News": 1,
    "Events": 1,
    "Groups": 60,
    "Articles": 10,
    "AtoZ": 60,
    "Directory": 1,
    "ContactUsArea": 60
  },
  "ElasticSearchAwsConfiguration": {
    "IndexFormat": "qa-{0:yyyy.MM-dd}",
    "Enabled": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Override": {
        "StockportContentApi.Utils.ICache": "Information"
      }
    }
  }
}
