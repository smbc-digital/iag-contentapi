{
  "Contentful:UsePreviewAPI": true,
  "UseAWSSecretManager": true,
  "AWSSecretsManagerConfiguration:EnvironmentGroupPrefix": "iag-preprod",
  "UseRedisSessions": "true",
  "redisExpiryTimes": {
    "News": 1,
    "Events": 1,
    "Groups": 60,
    "Articles": 10,
    "AtoZ": 60,
    "Directory": 15,
    "ContactUsArea": 60
  },
  "ElasticSearchAwsConfiguration": {
    "IndexFormat": "int-{0:yyyy.MM-dd}",
    "Enabled": true
  }
}